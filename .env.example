# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-botfather
# set the same value when registering the webhook (recommended in prod)
TELEGRAM_WEBHOOK_SECRET=some-random-string

# --- Azure Neural TTS ---
AZURE_SPEECH_KEY=your-subscription-key
AZURE_SPEECH_REGION=southeastasia
# Myanmar neural voice
TTS_VOICE=my-MM-ThihaNeural
# Max speech speed-up to fit subtitle windows.
#   1   = constant natural speed, never sped up (default; adjust speed yourself).
#   >1  = allow up to this much speed-up to keep cues near their timestamps.
TTS_MAX_RATE=1
# Max parallel TTS requests. Lower if Azure returns 429 (throttling).
TTS_CONCURRENCY=3
# Batch cues into one Azure call per ~N spoken seconds, cutting call volume.
#   0  = one call per cue (default; safest — exact timing, no truncation).
#   >0 = group cues up to ~N seconds (e.g. 30). Lower if long groups truncate.
TTS_GROUP_SECONDS=0
# Process-wide cap on concurrent Azure TTS calls across ALL jobs (TTS_CONCURRENCY
# only bounds one job). Prevents a 429 storm when MAX_CONCURRENT_JOBS is raised.
AZURE_TTS_MAX_CONCURRENCY=8

# --- OpenAI (transcription, whisper-1) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Google Gemini (translation) ---
GEMINI_API_KEY=your-gemini-api-key

# --- yt-dlp (optional) ---
# Path to a Netscape-format cookies.txt to get past YouTube's bot check.
# Export from a logged-in browser; mount it into the container.
# YTDLP_COOKIES=/cookies.txt
# Override the YouTube player client if extraction fails (e.g. tv, web_safari, ios).
# YTDLP_PLAYER_CLIENT=tv

# --- Cloudflare R2 (video hosting; YouTube jobs upload here, link is returned) ---
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_BUCKET=myancap-videos
# Public origin for returned links (r2.dev URL or a custom domain), no trailing slash.
AWS_URL=https://pub-xxxx.r2.dev
# Optional key prefix for uploads; pair with an R2 lifecycle rule for auto-expiry.
# AWS_KEY_PREFIX=videos/

# --- storage (SQLite) ---
# put this on a mounted volume in Docker so the cache survives restarts
DATABASE_PATH=/data/myancap.db

# --- runtime ---
WORK_DIR=/tmp/myancap
MAX_CONCURRENT_JOBS=1
MAX_VIDEO_SECONDS=900
# Cap downloaded video resolution. Video is hosted on R2 (not Telegram), so this
# just bounds file size + download time, not a hard delivery limit.
MAX_VIDEO_HEIGHT=1080
PORT=3000
